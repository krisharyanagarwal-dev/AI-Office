<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict/>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.aryan.opencode-caffeinate</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/aryanagarwal/Library/Logs/opencode-caffeinate.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/aryanagarwal/Library/Logs/opencode-caffeinate.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
