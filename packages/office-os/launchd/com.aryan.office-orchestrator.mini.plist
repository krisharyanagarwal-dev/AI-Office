<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac mini variant of the office orchestrator.

     Code comes from the read-only checkout at ~/ai-office-src, which
     import-integrity.sh hard-resets to origin every 30 min. State does NOT:
     OFFICE_OS_HOME points at ~/office-os, outside the checkout, because that
     reset runs `git clean -fd` and would otherwise delete the org state and
     logs every half hour.

     Interpreter is the homebrew build (3.15.2); the mini has no Python
     framework install, and its system python is 3.9.

     Providers, all keyless on this box: the configured chain leads with
     mlx_local -- the mlx_lm server the mini already runs on :11435 with
     Qwen3.5-9B -- then the two nvidia pools via the :4200 proxy, then
     google on the one key the mini's ~/.env does hold.

     Only ever run ONE orchestrator against one org state: bootout the
     laptop's copy before loading this. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aryan.office-orchestrator</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>-u</string>
		<string>/Users/a/ai-office-src/packages/office-os/core/orchestrator.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/a/ai-office-src/packages/office-os</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>OFFICE_OS_HOME</key>
		<string>/Users/a/office-os</string>
		<!-- The mini has no NVIDIA key in ~/.env and launchd gives a job none of
		     the shell's exports, so both nvidia pools in the fallback chain go
		     through the local nv_manager proxy, which holds the keys itself.
		     Verified on the mini with all four NVIDIA_API_KEY* vars removed:
		     api_key empty, call still answered. -->
		<key>OFFICE_ENDPOINT_NVIDIA_KEY3</key>
		<string>http://127.0.0.1:4200/v1/chat/completions</string>
		<key>OFFICE_ENDPOINT_NVIDIA_KEY4</key>
		<string>http://127.0.0.1:4200/v1/chat/completions</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/a/office-os/logs/orchestrator.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/a/office-os/logs/orchestrator.log</string>
</dict>
</plist>
