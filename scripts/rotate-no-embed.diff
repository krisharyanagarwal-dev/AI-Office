+    lines = []
+    if "oauth" in kinds or not kinds:
+        lines.append("   OAuth grant (gho_/ghu_/ghs_/ghr_): NOT on the Personal access "
+                     "tokens page. Revoke under Settings > Applications > Authorized "
+                     "OAuth grants, or with `gh auth logout --hostname github.com`.")
+    if "pat" in kinds or not kinds:
+        lines.append("   Personal access token (github_pat_/ghp_): revoked under "
+                     "Settings > Developer settings > Personal access tokens.")
+    if "unknown" in kinds:
+        lines.append("   One retired credential's class could not be determined; check "
+                     "both places above.")
+    lines.append("   Revocation only FOLLOWS a verified replacement. The secret that "
+                 "authenticates this repository may be the same one, so revoking it "
+                 "first is the 2026-10-16 outage: fetch starts answering \"Repository "
+                 "not found\" and the fleet loses its only sync path.")
