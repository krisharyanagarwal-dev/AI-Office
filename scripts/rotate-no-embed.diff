+"""The rotation script must not re-create the exposure it exists to close.
+
+Each test carries a positive control, because an assertion that the token is
+absent from a command list proves nothing if the command list was never built.
+"""
+
+import importlib.util
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "scripts" / "rotate_github_token.py"
+
+# Shaped like a classic PAT so TOKEN_RE accepts it, and deliberately carrying a
+# PLACEHOLDER_MARKERS word from scripts/scan_secrets.py: the secret scan checks
+# the VALUE, so a fixture that only looks fake-by-comment still trips it.
+SENTINEL = "ghp_faketoken0000000000000000000000000000"
+BARE = "https://github.com/krisharyanagarwal-dev/openalice-fleet.git"
+EMBEDDED = "https://x-access-token:%s@github.com/krisharyanagarwal-dev/" \
+           "openalice-fleet.git" % SENTINEL
+
+
+def _done(returncode=0, stderr="", stdout=""):
+    return subprocess.CompletedProcess(args=[], returncode=returncode,
+                                       stdout=stdout, stderr=stderr)
+
+
+def _strip_env(monkeypatch, rot, fail_on=None, fail_rc=128, unset_rc=0,
+               end_fetch=BARE, end_push=BARE):
+    """Route every git call strip_url_credentials makes through a recorder.
+
+    fail_on names the operation forced to exit non-zero and fail_rc is the status
+    it returns -- 128 by default, but 5 matters on its own: the script tolerates
+    exit 5 ONLY for the pushurl unset, so a 5 from set-url must still be fatal.
+    unset_rc sets the pushurl-unset status; end_fetch/end_push are what the
+    read-back sees.
+    """
+    issued = []
+
+    def fake(host, argv):
+        joined = " ".join(argv)
+        if "unset-all" in joined:
+            op = "unset"
+        elif "get-url" in joined:
+            op = "read"
+        elif "--push" in joined:
+            op = "push"
+        elif "set-url" in joined:
+            op = "fetch"
+        else:
+            op = "other"
+        issued.append(op)
+        if op == "read":
+            return _done(stdout=end_push if "--push" in joined else end_fetch)
+        if op == "unset":
+            return _done(returncode=unset_rc, stderr="unset failed")
+        return _done(returncode=fail_rc if op == fail_on else 0, stderr="git refused")
+
+    monkeypatch.setattr(rot, "run_on", fake)
+    monkeypatch.setattr(rot, "current_urls",
+                        lambda repo, host=None: {"origin": EMBEDDED})
+    return issued
+
+
+@pytest.fixture(scope="module")
+def rot():
+    spec = importlib.util.spec_from_file_location("rotate_github_token", SCRIPT)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_bare_removes_only_the_credential(rot):
+    assert rot.has_token(EMBEDDED) is True
+    assert rot.bare(EMBEDDED) == BARE
+    # A clean URL must survive untouched, or stripping would rewrite every remote.
+    assert rot.bare(BARE) == BARE
+    assert rot.has_token(BARE) is False
+
+
+def test_detects_a_token_used_as_the_username(rot):
+    """The shape that actually leaked: `gho_...@github.com`, userinfo with no colon.
+
+    A `user:pass@` detector silently misses this, and so would any guard that
+    only looks for a colon.
+    """
+    colonless = "https://ghp_faketoken0000000000000000000000000000@github.com/o/r.git"
+    assert rot.has_token(colonless) is True
+    assert rot.bare(colonless) == "https://github.com/o/r.git"
+
+
+def test_strip_writes_no_token_anywhere(rot, monkeypatch):
+    built = []
+    monkeypatch.setattr(rot, "current_urls",
+                        lambda repo, host=None: {"origin": EMBEDDED})
+
+    def record(host, argv):
+        built.append(list(argv))
+        return _done(stdout=BARE)
+
+    monkeypatch.setattr(rot, "run_on", record)
+
+    stripped = rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None,
+                                        dry_run=False)
+
+    assert stripped == 1
+    # Positive control: three writes plus the two read-backs really ran.
+    assert len(built) == 5, "nothing ran, so the absence below was vacuous"
+    joined = " ".join(" ".join(argv) for argv in built)
+    assert SENTINEL not in joined
+    assert BARE in joined
+    # fetch and push must be set together or push keeps the old credential.
+    assert any("--push" in argv for argv in built)
+
+
+def test_strip_aborts_when_the_fetch_rewrite_fails(rot, monkeypatch, capsys):
+    issued = _strip_env(monkeypatch, rot, fail_on="fetch")
+    with pytest.raises(SystemExit):
+        rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None, False)
+    assert issued == ["fetch"], "must stop at the first failure, not continue"
+    captured = capsys.readouterr()
+    assert "NOT counted as stripped" in captured.err
+    assert "1 remote URL(s) stripped" not in captured.out
+
+
+def test_strip_aborts_when_only_the_push_rewrite_fails(rot, monkeypatch, capsys):
+    """The half state the reviewer named: fetch reads bare, push still carries it."""
+    issued = _strip_env(monkeypatch, rot, fail_on="push")
+    with pytest.raises(SystemExit):
+        rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None, False)
+    # Positive control: the fetch really succeeded before the push failed.
+    assert issued == ["fetch", "push"]
+    captured = capsys.readouterr()
+    assert "NOT counted as stripped" in captured.err
+    assert "push url" in captured.err
+    assert "1 remote URL(s) stripped" not in captured.out
+
+
+def test_strip_aborts_when_the_read_back_is_still_dirty(rot, monkeypatch, capsys):
+    """Exit codes alone are not the end state: a pushurl can survive them."""
+    issued = _strip_env(monkeypatch, rot, end_push=EMBEDDED)
+    with pytest.raises(SystemExit):
+        rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None, False)
+    assert issued == ["fetch", "push", "unset", "read", "read"]
+    captured = capsys.readouterr()
+    assert "push DIRTY" in captured.err
+    assert SENTINEL not in captured.err + captured.out, \
+        "the diagnosis must not quote the credential"
+    assert "1 remote URL(s) stripped" not in captured.out
+
+
+def test_missing_pushurl_exit_five_is_tolerated(rot, monkeypatch):
+    issued = _strip_env(monkeypatch, rot, unset_rc=5)
+    assert rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None,
+                                    False) == 1
+    assert issued == ["fetch", "push", "unset", "read", "read"]
+
+
+def test_exit_five_on_the_fetch_rewrite_is_fatal(rot, monkeypatch, capsys):
+    """The allowance is scoped to one label: a 5 from set-url is not "no pushurl".
+
+    Pair with test_missing_pushurl_exit_five_is_tolerated; together they pin both
+    directions of `res.returncode == 5 and label == "stale pushurl"`.
+    """
+    issued = _strip_env(monkeypatch, rot, fail_on="fetch", fail_rc=5)
+    with pytest.raises(SystemExit):
+        rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None, False)
+    # Positive control: the fetch really ran and really returned 5.
+    assert issued == ["fetch"]
+    captured = capsys.readouterr()
+    assert "exit 5" in captured.err
+    assert "NOT counted as stripped" in captured.err
+    assert "1 remote URL(s) stripped" not in captured.out
+
+
+def test_exit_five_on_the_push_rewrite_is_fatal(rot, monkeypatch, capsys):
+    issued = _strip_env(monkeypatch, rot, fail_on="push", fail_rc=5)
+    with pytest.raises(SystemExit):
+        rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None, False)
+    assert issued == ["fetch", "push"], "must not sail past a push that returned 5"
+    captured = capsys.readouterr()
+    assert "exit 5" in captured.err
+    assert "push url" in captured.err
+    assert "NOT counted as stripped" in captured.err
+    assert "1 remote URL(s) stripped" not in captured.out
+
+
+def test_dry_run_issues_no_writes(rot, monkeypatch):
+    issued = _strip_env(monkeypatch, rot)
+    assert rot.strip_url_credentials(Path("/tmp/not-a-real-repo"), None,
+                                    True) == 1
+    assert issued == [], "dry run must not run a single git command"
+
+
+def test_install_credential_uses_stdin_not_argv(rot, monkeypatch, capsys):
+    calls = []
+
+    def fake_run(cmd, **kwargs):
+        calls.append((cmd, kwargs))
+        return _done()
+
+    monkeypatch.setattr(rot.subprocess, "run", fake_run)
+    rot.install_credential(SENTINEL, dry_run=False)
+
+    # Positive control: exactly one command ran, and it reported success.
+    assert len(calls) == 1
+    cmd, kwargs = calls[0]
+    assert " ".join(cmd).startswith("gh auth login")
+    assert SENTINEL not in " ".join(cmd), "token in argv is readable from ps"
+    assert kwargs.get("input") == SENTINEL, "token must reach gh on stdin"
+    assert SENTINEL not in capsys.readouterr().out, "never print the token"
+
+
+def test_install_failure_is_fatal(rot, monkeypatch):
+    monkeypatch.setattr(rot.subprocess, "run",
+                        lambda *a, **k: _done(returncode=1, stderr="boom"))
+    with pytest.raises(SystemExit):
+        rot.install_credential(SENTINEL, dry_run=False)
+
+
+def test_mini_is_measured_not_assumed(rot):
+    assert rot.mini_is_on_deploy_key({"origin": "git@github.com:o/r.git"}) is True
+    assert rot.mini_is_on_deploy_key({"origin": "ssh://git@github.com/o/r.git"}) is True
+    assert rot.mini_is_on_deploy_key({"origin": EMBEDDED}) is False
+    assert rot.mini_is_on_deploy_key({}) is False
+
+
+def _wire(rot, monkeypatch, mini_origin, laptop_origin=BARE, extra=(),
+          mini_ls_rc=0):
+    """Drive main() with the network and every subprocess replaced.
+
+    Records every command's ARGV, plus the stdin each child received, separately:
+    the token is allowed on stdin and nowhere else, so the two must be audited
+    apart. mini_ls_rc is what the mini returns for an ssh ls-remote -- the only
+    evidence that can certify an ssh-shaped origin.
+    """
+    argvs = []
+    stdins = []
+    monkeypatch.setattr(rot, "read_token", lambda: SENTINEL)
+    monkeypatch.setattr(rot, "verify", lambda t: {"login": "someone"})
+    monkeypatch.setattr(
+        rot, "verify_push",
+        lambda repo, host=None: argvs.append(["git", "fetch", "--dry-run", str(repo)]))
+    monkeypatch.setattr(
+        rot, "current_urls",
+        lambda repo, host=None: ({"origin": mini_origin} if host
+                                 else {"origin": laptop_origin, "public": BARE}))
+
+    def _fake_run_on(host, argv):
+        argvs.append((["ssh", str(host)] + argv) if host else list(argv))
+        rc = mini_ls_rc if (host and "ls-remote" in " ".join(argv)) else 0
+        return _done(returncode=rc)
+
+    def _fake_subprocess_run(*a, **k):
+        argvs.append(list(a[0]))
+        stdins.append(k.get("input"))
+        return _done()
+
+    monkeypatch.setattr(rot, "run_on", _fake_run_on)
+    monkeypatch.setattr(rot.subprocess, "run", _fake_subprocess_run)
+    monkeypatch.setattr(sys, "argv",
+                        ["rotate_github_token", "--hosts", "laptop,mini", *extra])
+    return argvs, stdins
+
+
+SSH_ORIGIN = "git@github.com:krisharyanagarwal-dev/openalice-fleet.git"
+
+
+def test_main_stops_short_when_the_mini_is_not_migrated(rot, monkeypatch, capsys):
+    argvs, stdins = _wire(rot, monkeypatch, EMBEDDED)
+    rc = rot.main()
+    out = capsys.readouterr().out
+
+    assert rc == 3, "a half rotation must not read as success"
+    assert "harden_mini_git.sh" in out
+    # Positive control: real commands were built, so the absence below is not vacuous.
+    assert len(argvs) >= 1
+    assert SENTINEL not in out, "the token must never be printed"
+    for argv in argvs:
+        assert SENTINEL not in " ".join(argv), "token reached a command line"
+    assert SENTINEL in stdins, "the keyring write must still happen"
+
+
+def test_ssh_shape_alone_does_not_certify_the_mini(rot, monkeypatch, capsys):
+    """The state measured today: ssh-shaped origin, GitHub refuses the repository."""
+    argvs, _ = _wire(rot, monkeypatch, SSH_ORIGIN)
+    rc = rot.main()
+    out = capsys.readouterr().out
+
+    assert rc == 3, "shape is not evidence; an unverified remote is unfinished"
+    assert "cannot break this host" not in out, "that claim needs a check behind it"
+    assert "UNVERIFIED" in out
+    assert "git ls-remote '%s' HEAD" % SSH_ORIGIN in out, "name the verifying command"
+    # Positive control: nothing was addressed to the mini, because none was asked for.
+    assert not any(a[0] == "ssh" for a in argvs)
+
+
+def test_verified_ssh_remote_certifies(rot, monkeypatch, capsys):
+    argvs, _ = _wire(rot, monkeypatch, SSH_ORIGIN, extra=("--verify-mini",),
+                     mini_ls_rc=0)
+    rc = rot.main()
+    out = capsys.readouterr().out
+
+    assert rc == 0
+    assert "cannot break this host" in out
+    to_mini = [a for a in argvs if a[0] == "ssh"]
+    # Positive control: exactly one command went to the mini, and it was the check.
+    assert len(to_mini) == 1
+    assert "ls-remote" in " ".join(to_mini[0])
+    assert SSH_ORIGIN in " ".join(to_mini[0])
+
+
+def test_failed_ssh_evidence_does_not_certify(rot, monkeypatch, capsys):
+    argvs, _ = _wire(rot, monkeypatch, SSH_ORIGIN, extra=("--verify-mini",),
+                     mini_ls_rc=128)
+    rc = rot.main()
+    out = capsys.readouterr().out
+
+    assert rc == 3
+    assert "cannot break this host" not in out
+    assert "NOT certified" in out
+    assert [a for a in argvs if a[0] == "ssh"], "the check must really be addressed"
+
+
+def test_ssh_remote_for_another_repository_does_not_certify(rot, monkeypatch, capsys):
+    """git@github.com is the right shape and the wrong repo."""
+    argvs, _ = _wire(rot, monkeypatch, "git@github.com:someone-else/other.git",
+                     extra=("--verify-mini",))
+    rc = rot.main()
+    out = capsys.readouterr().out
+    assert rc == 3
+    assert "cannot break this host" not in out
+
+
+def test_main_reports_the_right_revocation_page_for_an_oauth_grant(
+        rot, monkeypatch, capsys):
+    oauth_url = "https://gho_faketoken0000000000000000000000000000@github.com/" \
+                "krisharyanagarwal-dev/openalice-fleet.git"
+    # The mini here is ssh-shaped and carries no credential, so the only retired
+    # secret is the laptop's gho_ grant. An EMBEDDED mini would legitimately add a
+    # PAT-shaped one, and then both pages must be named.
+    argvs, stdins = _wire(rot, monkeypatch, SSH_ORIGIN, laptop_origin=oauth_url)
+    rc = rot.main()
+    out = capsys.readouterr().out
+    assert rc == 3
+    assert "Authorized OAuth grants" in out
+    assert "gh auth logout" in out
+    assert "Settings > Developer settings > Personal access tokens" not in out, \
+        "the PAT page does not list a CLI grant"
+    assert "only FOLLOWS a verified replacement" in out
+    assert "gho_faketoken" not in out, "name the class, never the value"
+
+
+def test_token_class_maps_by_prefix_only(rot):
+    assert rot.credential_kind("github_pat_abc") == "pat"
+    assert rot.credential_kind("ghp_abc") == "pat"
+    for p in rot.OAUTH_PREFIXES:
+        assert rot.credential_kind(p + "abc") == "oauth"
+    assert rot.credential_kind("x" * 40) == "unknown"
+    assert rot.credential_kind("") == "unknown"
+    assert rot.credential_kind(None) == "unknown"
+
+
+def test_url_credential_reads_the_colonless_form(rot):
+    assert rot.url_credential(EMBEDDED) == SENTINEL
+    assert rot.url_credential("https://%s@github.com/o/r.git" % SENTINEL) == SENTINEL
+    assert rot.url_credential(BARE) is None
+    assert rot.url_credential("") is None
+    assert rot.credential_kind(rot.url_credential(
+        "https://gho_faketoken0000000000000000000000000000@github.com/o/r.git")) == "oauth"
+
+
+def test_revocation_note_routes_by_class(rot):
+    oauth = rot.revocation_note(["oauth"])
+    assert "Authorized OAuth grants" in oauth
+    assert "Settings > Developer settings > Personal access tokens" not in oauth
+    pat = rot.revocation_note(["pat"])
+    assert "Settings > Developer settings > Personal access tokens" in pat
+    assert "Authorized OAuth grants" not in pat
+    both = rot.revocation_note([])
+    assert "Authorized OAuth grants" in both and "Personal access tokens" in both
+    for note in (oauth, pat, both, rot.revocation_note(["unknown"])):
+        assert "only FOLLOWS a verified replacement" in note
+        assert "stays live" in note
+    assert SENTINEL not in oauth + pat + both
