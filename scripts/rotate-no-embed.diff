+def test_no_url_is_rewritten_until_the_keyring_proves_itself(rot, monkeypatch):
+    """Ordering guard: prove first, strip second.
+
+    The credential this repo fell back on was the session token pasted into the
+    remote URL. Stripping it before demonstrating that the helper answers on its
+    own is how a rotation turns into a fetch outage.
+    """
+    argvs, _ = _wire(rot, monkeypatch, EMBEDDED, laptop_origin=EMBEDDED)
+
+    def failing(host, argv):
+        argvs.append(list(argv))
+        return _done(returncode=128, stderr="remote: Repository not found")
+
+    monkeypatch.setattr(rot, "run_on", failing)
+    with pytest.raises(SystemExit):
+        rot.main()
+
+    joined = [" ".join(argv) for argv in argvs]
+    # Positive control: the proof really ran and really failed.
+    assert any("ls-remote" in argv for argv in joined)
+    assert not any("set-url" in argv for argv in joined), \
+        "the stored remote was rewritten on top of an unproven credential"
+
+
+def test_prove_keyring_auth_targets_the_bare_url(rot, monkeypatch):
