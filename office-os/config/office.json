    "nvidia_key3",
    "nvidia_key4",
    "google",
    "openrouter"
  ],
  "autopilot": {
    "enabled": true,
    "interval_min": 30,
    "max_rounds_per_day": 24,
    "startup_delay_sec": 60,
    "topic": "Look at what this office has recently done and say what the single most valuable next piece of work in your specialty would be, and why.",
    "create_tasks": true,
    "max_reply_tokens": 2000,
    "parallel_agents": 3,
    "call_timeout_sec": 150
  },
  "autonomy": {
    "enabled": true,
    "stop_file": "/Users/aryanagarwal/office-os/STOP",
    "max_act_tasks_per_day": 6,
    "repo_allowlist": [
      "/Users/aryanagarwal/office-os",
      "/Users/aryanagarwal/dashboard-hub"
    ],
    "restart_label_allowlist": [
      "com.aryan.office-os",
      "com.aryan.office-os-web"
    ],
    "forbidden_path_patterns": [
      ".env",
      "*.plist",
      "*key*",
      "*secret*",
      "*token*",
      "live_orders",
      "order",
      "executor"
    ],
    "executor_enabled": true
  },
  "departments": [
    {
      "id": "fleet-health",
      "leads": [
        "sre-site-reliability-engineer",
        "incident-response-commander",
        "devops-automator"
      ],
      "sources": [
        "office-manager",
        "office-hud",
        "dashboard-hub",
        "openalice-fleet",
        "laptop-jobs",
        "mini-office"
      ],
      "brief": "Look at the organisation state below. Name the single most important broken or stale system and what to check first. Read-only: propose the exact check or fix, do not run it.",
      "guardrails": [
        "read-only in this phase",
        "never restart a service without the allowlist"
      ]
    },
    {
      "id": "trading-research",
      "leads": [
        "quant-research-manager",
        "backtest-auditor",
        "quant-model-validator"
      ],
      "sources": [
        "dashboard-hub:/api/trading"
      ],
      "brief": "Review the paper trading research. PAPER AND TESTNET ONLY. Gross edge is not profit: any claim must state venue, fee and funding, and a horizon is viable only when its confidence interval excludes zero AND it clears modelled costs. Never lower a sample floor to get a verdict.",
      "guardrails": [
        "paper/testnet only",
        "no order path ever",
        "live_orders_allowed stays false",
        "output to research/ only"
      ]
    },
    {
      "id": "store",
      "leads": [
        "growth-hacker",
        "product-marketer",
        "data-analyst"
      ],
      "sources": [],
      "brief": "Good Wearr store. No store data source is connected yet: say so plainly, then propose the read-only data you would need. Do not invent figures.",
      "guardrails": [
        "no store data connected",
        "never change store settings or submit forms"
      ]
    },
    {
      "id": "upkeep",
      "leads": [
        "code-reviewer",
        "software-architect",
        "qa-tester"
      ],
      "sources": [
        "~/office-os",
        "~/dashboard-hub",
        "~/office-manager"
      ],
      "brief": "Review the office systems' own code, tests and docs. Name one concrete improvement with the file and line it belongs to.",
      "guardrails": [
        "propose only in this phase"
      ]
    }
  ]
}