<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BUILDER_NO_SYNC</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.aryan.dashboard-workers</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>exec /usr/bin/python3 /Users/aryanagarwal/dashboard-hub/workers/worker.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/com.aryan.dashboard-workers.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/com.aryan.dashboard-workers.out</string>
	<key>StartInterval</key>
	<integer>1800</integer>
</dict>
</plist>
