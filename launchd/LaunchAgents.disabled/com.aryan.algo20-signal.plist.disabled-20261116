<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aryan.algo20-signal</string>
    <!-- Laptop-side. algo20 runs on the mini, but the operator is at the
         laptop, so the verdict is pulled here and re-notified on change. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aryanagarwal/openalice-fleet/scripts/algo20_signal_relay.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/aryanagarwal/openalice-fleet</string>
    <key>StartInterval</key>
    <integer>300</integer>
    <!-- false: installing this must not immediately fire a notification; the
         relay's first run establishes the baseline signature. -->
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/aryanagarwal/openalice-fleet/logs/algo20_signal.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aryanagarwal/openalice-fleet/logs/algo20_signal_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- ~/.local/bin must be on PATH or launchd cannot find `jev` and the
             suppression gate silently degrades to always-notify. -->
        <key>PATH</key>
        <string>/Users/aryanagarwal/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/aryanagarwal</string>
        <key>ALGO_MINI</key>
        <string>a@macmini</string>
        <!-- JEV triage gate, live. It may only SUPPRESS a high-confidence
             "informational", and only while scripts/jev_calibrate.py keeps
             reporting meets_bar_for_suppression. If the calibration is missing,
             stale, or below bar the relay disables the gate itself. -->
        <key>OPENALICE_ALGO_JEV</key>
        <string>1</string>
        <key>OPENALICE_ALGO_JEV_CONFIDENCE</key>
        <string>0.80</string>
        <!-- Pull the mini's daily digest; the laptop never computes economics. -->
        <key>OPENALICE_ALGO_DIGEST</key>
        <string>1</string>
    </dict>
</dict>
</plist>