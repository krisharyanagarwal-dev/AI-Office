<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aryan.codex-nvidia-env</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aryanagarwal/.codex/codex-nvidia-env.sh</string>
  </array>

  <!-- Run at login, and hourly to re-assert the key (a reboot or a launchd
       environment reset would otherwise leave the GUI app without it). -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/codex-nvidia-env.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/codex-nvidia-env.err.log</string>
</dict>
</plist>
