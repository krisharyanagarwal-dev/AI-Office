<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aryan.jev-calibrate</string>
    <!-- Runs on the laptop because that is where jev and the relay live; the
         mini has no jev binary. Feeds the relay's self-demotion guard. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/aryanagarwal/openalice-fleet/scripts/jev_calibrate.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/aryanagarwal/openalice-fleet</string>
    <!-- Weekly, Monday 09:10. Off the hour so it does not pile onto whatever
         else fires at :00 on this box. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <!-- false: first calibration is a human step so install cannot surprise.
         The relay treats a missing file as below-bar, so an unrun calibration
         disables suppression rather than enabling it. -->
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/aryanagarwal/openalice-fleet/logs/jev_calibrate.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aryanagarwal/openalice-fleet/logs/jev_calibrate_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/aryanagarwal/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/aryanagarwal</string>
    </dict>
</dict>
</plist>
