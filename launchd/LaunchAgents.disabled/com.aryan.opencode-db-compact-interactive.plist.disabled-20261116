<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aryan.opencode-db-compact-interactive</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/aryanagarwal/.local/share/openalice-maintenance/scripts/opencode_db_compact_interactive.py</string>
        <string>--apply</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/aryanagarwal/.local/share/openalice-maintenance</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <!-- Every 30 minutes. The job is a no-op unless the interactive OpenCode
         database has no writer AND holds at least 512 MiB of free pages, so a
         frequent tick costs one lsof plus two pragmas and reclaims the space
         the first time the operator closes OpenCode. -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/aryanagarwal/.local/share/openalice-maintenance/logs/opencode-db-compact-interactive.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aryanagarwal/.local/share/openalice-maintenance/logs/opencode-db-compact-interactive.err.log</string>
</dict>
</plist>
