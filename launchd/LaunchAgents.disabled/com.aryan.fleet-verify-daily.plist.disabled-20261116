<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily unscoped verify at 05:20: after the 04:00 durable backup and clear of polymarket-backup 03:00.
  Writes ~/.fleet-workflow/verify-freshness, which com.aryan.fleet-backup-watch checks, so a run that
  stops happening is distinguishable from a run that found nothing. No KeepAlive.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aryan.fleet-verify-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aryanagarwal/bin/fleet-verify-daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>20</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/aryanagarwal/.fleet-workflow/verify-daily-launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/aryanagarwal/.fleet-workflow/verify-daily-launchd-error.log</string>
</dict>
</plist>
