<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly freshness alarm for the durable backup. Writes its own heartbeat so an absent watcher is not
  mistaken for a healthy backup -- the specific silence that hid two dead jobs on this host.
  No KeepAlive: an exiting checker is supposed to exit.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aryan.fleet-backup-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aryanagarwal/bin/fleet-backup-watch.sh</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/aryanagarwal/.fleet-workflow/backup-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/aryanagarwal/.fleet-workflow/backup-watch-error.log</string>
</dict>
</plist>
